{
  "info": {
    "_postman_id": "0d4c0b1e-0000-4000-8000-000000000001",
    "name": "Shop API",
    "description": { "content": "API de démonstration", "type": "text/plain" },
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "event": [
    { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.variables.set('startedAt', Date.now());"] } }
  ],
  "variable": [
    { "key": "baseUrl", "value": "https://shop.test/v1" },
    { "key": "page size", "value": 20 }
  ],
  "item": [
    {
      "name": "Users",
      "description": "Gestion des comptes",
      "auth": { "type": "basic", "basic": [{ "key": "username", "value": "admin" }, { "key": "password", "value": "{{adminPassword}}" }] },
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "get",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Debug", "value": "1", "disabled": true }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/:team?page=1&verbose=true",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":team"],
              "query": [{ "key": "page", "value": "1" }, { "key": "verbose", "value": "true", "disabled": true }],
              "variable": [{ "key": "team", "value": "core" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.environment.set('firstUser', pm.response.json()[0].id);",
                  "});"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Two users",
              "originalRequest": { "method": "GET", "url": { "raw": "{{baseUrl}}/users/core" } },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "[{\"id\":1},{\"id\":2}]"
            }
          ]
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"Aminata\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/users",
            "description": "Crée un compte",
            "auth": { "type": "apikey", "apikey": [{ "key": "key", "value": "api_key" }, { "key": "value", "value": "{{apiKey}}" }, { "key": "in", "value": "query" }] }
          }
        },
        {
          "name": "Upload avatar",
          "request": {
            "method": "PUT",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "caption", "value": "Photo", "type": "text" },
                { "key": "avatar", "type": "file", "src": "avatars/aminata.png", "contentType": "image/png" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/users/1/avatar" },
            "auth": { "type": "noauth" }
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "body": { "mode": "urlencoded", "urlencoded": [{ "key": "grant", "value": "password" }, { "key": "user", "value": "{{user}}", "disabled": true }] },
        "url": { "raw": "{{baseUrl}}/login#fragment" }
      }
    },
    {
      "name": "Login",
      "request": { "method": "DELETE", "url": { "protocol": "https", "host": ["shop", "test"], "path": ["logout"], "query": [{ "key": "all", "value": "1" }] } }
    },
    {
      "name": "Products query",
      "request": {
        "method": "POST",
        "body": { "mode": "graphql", "graphql": { "query": "{ products { id } }", "variables": "{\"first\": 10}" } },
        "url": { "raw": "{{baseUrl}}/graphql" }
      }
    },
    {
      "name": "Token",
      "request": {
        "method": "POST",
        "url": { "raw": "{{baseUrl}}/oauth/token" },
        "auth": {
          "type": "oauth2",
          "oauth2": [
            { "key": "grant_type", "value": "client_credentials" },
            { "key": "accessTokenUrl", "value": "{{baseUrl}}/oauth/token" },
            { "key": "clientId", "value": "shop" },
            { "key": "clientSecret", "value": "{{clientSecret}}" },
            { "key": "scope", "value": "read" },
            { "key": "tokenName", "value": "shopToken" },
            { "key": "addTokenTo", "value": "header" },
            { "key": "headerPrefix", "value": "Bearer" },
            { "key": "client_authentication", "value": "body" },
            { "key": "tokenRequestParams", "value": [{ "key": "audience", "value": "shop-api", "send_as": "request_body" }] }
          ]
        }
      }
    },
    { "name": "Broken", "request": { "url": "{{baseUrl}}/nothing" } },
    "not an item"
  ]
}
